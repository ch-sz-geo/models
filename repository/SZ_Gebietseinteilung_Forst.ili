INTERLIS 2.4;
!!==============================================================================
!!@ Title               = "Gebietseinteilung Forst";
!!@ shortDescription    = "Einteilung des Kantonsgebietes in Forstkreise und Forstgebiete gemäss der kantonalen Verordnung zum Waldgesetz (SRSZ 313.111)";
!!@ technicalContact    = "mailto:geoportal@sz.ch";
!!@ furtherInformation  = "https://www.sz.ch";
!!@ Themennummer        = "A246";
!!@ Compiler-Version    = "ili2c-5.6.3-720ae8bf5621734004b9d234fde4d2fe9556b943";
!!------------------------------------------------------------------------------
!!      Version     | wer | was
!! Datum      | Nr  |     |
!!------------------------------------------------------------------------------
!! 2025-01-24 | 1.0 | Kep | Erstfassung
!! 2025-03-06 | 1.0 | Kep | Einfügen der Beziehungsklasse "Personenadresse"
!!==============================================================================
MODEL SZ_Gebietseinteilung_Forst_V1 (de)
  AT "https://models.geo.sz.ch"
  VERSION "2025-01-24" =

  IMPORTS UNQUALIFIED INTERLIS;

  DOMAIN
    BasketID = OID TEXT*255;
    Punkt =
      COORD 2672000.000 .. 2719000.000 [m]
           ,1193000.000 .. 1232000.000 [m]
           ,ROTATION 2 -> 1;
    Gebietseinteilung =
      AREA WITH (STRAIGHTS) VERTEX Punkt WITHOUT OVERLAPS > 0.001;

!!------------------------------------------------------------------------------
  TOPIC Stammdaten =
    BASKET OID AS BasketID;
    OID AS UUIDOID;
!!------------------------------------------------------------------------------
    CLASS Katalogeintrag (ABSTRACT) =
      Code       :  MANDATORY  TEXT*255;
      Name       :  MANDATORY  TEXT*255;
      SortierNr  :  MANDATORY -999999 .. 999999;
      Bemerkung  :             TEXT*1000;
    END Katalogeintrag;

    CLASS Adresstyp EXTENDS Katalogeintrag =
      UNIQUE Code;
      UNIQUE Name;
    END Adresstyp;

  END Stammdaten;

!!------------------------------------------------------------------------------
  TOPIC Fachdaten =
    BASKET OID AS BasketID;
    OID AS UUIDOID;
    DEPENDS ON SZ_Gebietseinteilung_Forst_V1.Stammdaten;
!!------------------------------------------------------------------------------
    CLASS Forstkreis =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
      Nummer        :  MANDATORY  1..9;
      Bezeichnung   :  MANDATORY  TEXT*100;
      Bemerkung     :             MTEXT*1000;
      UNIQUE Nummer;
    END Forstkreis;

    CLASS Forstrevier =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
      Nummer        :  MANDATORY  1..99;
      Bezeichnung   :             TEXT*100;
      Bemerkung     :             MTEXT*1000;
      UNIQUE Nummer;
    END Forstrevier;

    CLASS Gebiet =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
      Bemerkung     :             MTEXT*1000;
      Geometrie     :  MANDATORY  Gebietseinteilung;
    END Gebiet;

    CLASS Person =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
      Vorname       :             TEXT*50;
      Nachname      :             TEXT*50;
      Tel_G         :             TEXT*20;
      Tel_M         :             TEXT*20;
      E_Mail        :             TEXT*100;
    END Person;

    CLASS Adresse =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
      Zeile_1       :             TEXT*50;      !! bei Domiziladresse: Bahnhofstrasse 16; bei Postadresse: Postfach 1234
      Zeile_2       :             TEXT*50;      !! im Normalfall leer
      PLZ           :             1000..9999;
      Ort           :             TEXT*50;
    END Adresse;

    CLASS Personenadresse =
      erfasstVon    :  MANDATORY  TEXT*100;
      erfasstAm     :  MANDATORY  XMLDateTime;
      geaendertVon  :  MANDATORY  TEXT*100;
      geaendertAm   :  MANDATORY  XMLDateTime;
    END Personenadresse;

    ASSOCIATION Forstkreis__Forstrevier =
      rForstkreis   --  {1}     Forstkreis;
      rForstrevier  --  {0..*}  Forstrevier;
    END Forstkreis__Forstrevier;

    ASSOCIATION Forstrevier__Gebiet =
      rForstrevier  --  {1}     Forstrevier;
      rGebiet       --  {0..*}  Gebiet;
    END Forstrevier__Gebiet;

    ASSOCIATION Person__Forstkreis =
      rKreisfoerster  --  {1..*}  Person;
      rForstkreis     --  {0..*}  Forstkreis;
    END Person__Forstkreis;

    ASSOCIATION Person__Forstrevier =
      rRevierfoerster  --  {1..*}  Person;
      rForstrevier     --  {0..*}  Forstrevier;
    END Person__Forstrevier;

    ASSOCIATION Person__Personenadresse =
      rPerson           --  {1}     Person;
      rPersonenadresse  --  {0..*}  Personenadresse;
    END Person__Personenadresse;

    ASSOCIATION Adresse__Personenadresse =
      rAdresse          --  {1}     Adresse;
      rPersonenadresse  --  {0..*}  Personenadresse;
    END Adresse__Personenadresse;

    ASSOCIATION Adresstyp__Personenadresse =
      rAdresstyp (EXTERNAL)  --  {1}     SZ_Gebietseinteilung_Forst_V1.Stammdaten.Adresstyp;
      rPersonenadresse       --  {0..*}  Personenadresse;
    END Adresstyp__Personenadresse;

  END Fachdaten;

END SZ_Gebietseinteilung_Forst_V1.